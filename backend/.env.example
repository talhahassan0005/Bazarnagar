# Server
PORT=5000
NODE_ENV=development

# Allowed frontend origin for CORS (the Next.js app)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB — local mongod OR a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/bazaarnagar

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public base URL of THIS backend (used to build absolute image URLs)
PUBLIC_URL=http://localhost:5000

# Frontend base URL for payment gateway redirects (set to your frontend port)
APP_URL=http://localhost:3000

# Safepay (Pakistan: EasyPaisa + JazzCash + card). Leave SAFEPAY_API_KEY blank
# to run in MOCK mode (a local test gateway — great for demos). Get keys from
# https://getsafepay.com  ·  SAFEPAY_ENV = sandbox | production
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox

# Seed an admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@bazaarnagar.com
ADMIN_PASSWORD=admin123
