# Server
PORT=5000
NODE_ENV=development

# Allowed frontend origin for CORS (the Next.js app)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB — local mongod OR a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/bazaarnagar

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public base URL of THIS backend (used to build absolute image URLs)
PUBLIC_URL=http://localhost:5000

# Frontend base URL for payment gateway redirects (set to your frontend port)
APP_URL=http://localhost:3000

# Stripe. Leave STRIPE_SECRET_KEY blank to run in MOCK mode (a local test
# gateway — great for demos). Get keys from https://dashboard.stripe.com
# Secret key: Developers -> API keys -> Secret key (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Webhook signing secret: Developers -> Webhooks -> your endpoint -> Signing
# secret (whsec_...). Endpoint URL to register: <PUBLIC_URL>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Stripe does not support a Pakistani merchant account — set this to whatever
# currency your connected Stripe account actually settles in.
STRIPE_CURRENCY=usd

# Seed an admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@bazaarnagar.com
ADMIN_PASSWORD=admin123
